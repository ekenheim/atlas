# Copy to .env and adjust. Values are whitespace/CR-stripped on load.
# Fixture-only defaults: no paid keys needed.

# --- Required ---
# Direct primary, never pgbouncer (migrations and the job queue need session semantics).
ATLAS_DATABASE_URL=postgresql+psycopg://atlas:atlas@127.0.0.1:55432/atlas
# Actor recorded on every mutation (pilot: from config; later an authenticated principal).
ATLAS_ACTOR=local-researcher
# Filesystem archive root (the dev default backend).
ATLAS_ARCHIVE_ROOT=./data/archive

# Archive backend: filesystem (default, under ATLAS_ARCHIVE_ROOT) or s3.
# The ATLAS_S3_* settings are required only for s3 (the Compose Silo values shown).
# ATLAS_ARCHIVE_BACKEND=filesystem
# ATLAS_S3_ENDPOINT_URL=http://127.0.0.1:59000
# ATLAS_S3_BUCKET=atlas-archive
# ATLAS_S3_ACCESS_KEY_ID=
# ATLAS_S3_SECRET_ACCESS_KEY=
# ATLAS_S3_REGION=us-east-1

# --- Optional: unset = feature disabled (logged once at startup) ---
# Serve the static frontend export (the image sets /app/frontend).
# ATLAS_FRONTEND_DIR=./frontend/out
# ATLAS_HINDSIGHT_URL=http://127.0.0.1:8888
# ATLAS_HINDSIGHT_API_KEY=
# ATLAS_HINDSIGHT_BANK_ID=atlas-ai-infrastructure
# ATLAS_LITELLM_URL=https://litellm.<domain>
# ATLAS_LITELLM_API_KEY=
# The research bank template applied by `atlas hindsight apply-template`.
# ATLAS_HINDSIGHT_TEMPLATE_PATH=configs/hindsight/bank-template.json
# LiteLLM aliases (each run records the deployment behind them from /model/info).
# ATLAS_LLM_EXTRACT_ALIAS=atlas-extract
# ATLAS_LLM_REFLECT_ALIAS=atlas-reflect
# Research roles (Scout, Investigator, ...): the model their chat completions ask for, extra
# body fields (a JSON object; thinking off by default), the HTTP timeout, and each run's
# token ceiling (input + output).
# ATLAS_LLM_ROLE_MODEL=MiniMax-M3
# ATLAS_LLM_ROLE_EXTRA_BODY={"thinking":{"type":"disabled"}}
# ATLAS_LLM_ROLE_TIMEOUT_SECONDS=180
# ATLAS_RUN_TOKEN_BUDGET=200000
# The Investigator's claim extraction: at most this many passages per extraction, sent
# this many per LLM call.
# ATLAS_INVESTIGATOR_MAX_PASSAGES=24
# ATLAS_INVESTIGATOR_PASSAGES_PER_CALL=6
# ATLAS_REVIEWER_ASSERTIONS_PER_CALL=5

# Discovery: SearXNG (optional; without it the `discover` job fails), the engines every
# search names (the instance's defaults are partly broken, so name them), its timeout, and
# the most Scout queries searched per discovery (at most 10).
# ATLAS_SEARXNG_URL=https://search.<domain>
# ATLAS_SEARXNG_ENGINES=bing,brave
# ATLAS_SEARXNG_TIMEOUT_SECONDS=30
# ATLAS_DISCOVERY_MAX_QUERIES=10
# Investigations: the default per-run lead and document budgets (at most 10 and 25; a
# request may lower them). The token ceiling is ATLAS_RUN_TOKEN_BUDGET.
# ATLAS_INVESTIGATION_MAX_LEADS=10
# ATLAS_INVESTIGATION_MAX_DOCUMENTS=25
# Retention (with Hindsight on, each new parsed Source Version is retained): one poll job
# waits this long for its operation (keep it below ATLAS_JOB_LEASE_SECONDS), asking at this
# interval; a timed-out poll is retried up to the attempts bound.
# ATLAS_RETAIN_POLL_TIMEOUT_SECONDS=240
# ATLAS_RETAIN_POLL_INTERVAL_SECONDS=5
# ATLAS_RETAIN_POLL_ATTEMPTS=5
# Retention triage: read each new version section by section and retain only what adds
# durable value (auto = on when LiteLLM is configured; off retains every section). The Triage
# role sees each section's first N characters, this many sections to a call.
# ATLAS_RETENTION_TRIAGE=auto
# ATLAS_TRIAGE_EXCERPT_CHARS=1500
# ATLAS_TRIAGE_SECTIONS_PER_CALL=15
# Mental models (Theme status, Bottlenecks): the worker enqueues each model's daily refresh
# from this UTC time on (HH:MM; empty = never). The template's own refresh_cron is 06:00 UTC;
# Atlas's job skips a model refreshed inside its minimum interval or with nothing new.
# ATLAS_MENTAL_MODEL_REFRESH_AT=06:30
# ATLAS_MENTAL_MODEL_POLL_TIMEOUT_SECONDS=240
# ATLAS_MENTAL_MODEL_POLL_INTERVAL_SECONDS=5
# Recorded on every run; the image sets the commit SHA. Unset = the package version.
# ATLAS_CODE_VERSION=
# Local Hindsight (`docker compose --profile hindsight up -d`) uses ATLAS_LITELLM_* and:
# ATLAS_HINDSIGHT_PORT=58888
# ATLAS_HINDSIGHT_LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
# Live SEC EDGAR fetching (off = replay recorded fixtures). When on, the User-Agent is
# required: a requester name and contact email (SEC fair-access policy).
# ATLAS_SEC_LIVE=true
# ATLAS_SEC_USER_AGENT=Atlas Research you@example.com
# Fixture mode (ATLAS_SEC_LIVE off): recorded EDGAR responses, one directory per company.
# ATLAS_SEC_FIXTURES_DIR=tests/fixtures/edgar
# Entity resolution (`atlas companies resolve`) sources (defaults shown; SEC also needs
# ATLAS_SEC_USER_AGENT).
# ATLAS_SEC_FILES_URL=https://www.sec.gov/files
# ATLAS_SEC_DATA_URL=https://data.sec.gov
# ATLAS_GLEIF_URL=https://api.gleif.org/api/v1
# ATLAS_OPENFIGI_URL=https://api.openfigi.com

# Exchange adapters (HKEXnews). Every request passes the fetch gate: the site register
# (configs/sources/sites.yaml: HKEXnews' terms forbid automation, so it stays blocked until a
# consent is recorded there) and robots.txt. Live is opt-in; otherwise fixtures are replayed.
# ATLAS_EXCHANGE_LIVE=true
# ATLAS_EXCHANGE_USER_AGENT=AtlasResearch   (generic; never an email or other personal data)
# ATLAS_EXCHANGE_FIXTURES_DIR=tests/fixtures/hkexnews
# ATLAS_SOURCE_SITES_CONFIG=configs/sources/sites.yaml
# The company universe and themes (default shown; the image ships /app/configs).
# ATLAS_THEMES_CONFIG=configs/themes/ai-infrastructure.yaml
# The evaluation gold set `atlas evaluate` runs (docs/evaluation-methodology.md).
# ATLAS_EVALUATION_GOLD_DIR=tests/evaluation/gold

# --- Optional tuning (defaults shown) ---
# Job queue: idle poll interval of `atlas worker`, and the claim lease before reclaim.
# ATLAS_WORKER_POLL_SECONDS=5
# ATLAS_JOB_LEASE_SECONDS=300
# Pacing: backfill-class jobs (`--backfill`) run only in this local-time window, one or more
# comma-separated ranges (empty, the default: any time); a 429 or outage pauses the Hindsight
# and LiteLLM job kinds, doubling from the base to the cap (≤ 1 h).
# ATLAS_BACKFILL_WINDOW=
# ATLAS_BACKFILL_TIMEZONE=UTC
# ATLAS_QUEUE_PAUSE_BASE_SECONDS=60
# ATLAS_QUEUE_PAUSE_MAX_SECONDS=3600
# Budgets per rolling window, window or not: Codex (Hindsight retain/reprocess operations
# submitted) and MiniMax (recorded role-call tokens). Backfill leaves the last reserve share
# of each for interactive work. See docs/runbooks.md, "Universe rollout and quota budgets".
# ATLAS_BUDGET_WINDOW_HOURS=5
# ATLAS_CODEX_BUDGET_OPERATIONS=40
# ATLAS_MINIMAX_BUDGET_TOKENS=400000
# ATLAS_BUDGET_INTERACTIVE_RESERVE=0.3

# --- Spike only (spikes/hindsight/run.sh) ---
# LITELLM_URL=https://litellm.<domain>
# LITELLM_API_KEY=
